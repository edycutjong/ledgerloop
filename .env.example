# ── Supabase ─────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Arbitrum Sepolia RPC ─────────────────────────────────────
# Get from: https://alchemy.com or https://infura.io
NEXT_PUBLIC_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/your-key

# ── GNN Backend ──────────────────────────────────────────────
# Local FastAPI daemon URL
NEXT_PUBLIC_GNN_API_URL=http://localhost:8000
